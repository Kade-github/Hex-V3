package kade.hex.songs;

import funkin.play.song.Song;
import funkin.modding.module.ModuleHandler;
import funkin.play.PlayState;
import funkin.play.character.CharacterType;
import funkin.save.Save;
class DetectedSong extends Song {
	public function new() {
  	super("detected");

	}

  public override function onSongLoaded(event) {
    loadModchart();

    super.onSongLoaded(event);
    rimOn();
  }

  function loadModchart() {
    var diff = PlayState.instance.currentDifficulty;

    var modId = (diff != null && diff.toLowerCase() == "normal") ? "detected_modchart_normal" : "detected_modchart";

    if (diff != null && diff.toLowerCase() == "easy")
      modId = null;

    for (other in ["detected_modchart", "detected_modchart_normal"]) {
      if (other == modId)
        continue;

      var was = ModuleHandler.getModule(other);
      if (was != null)
        was.unload();
    }

    if (modId == null)
      return;

    var modchart = ModuleHandler.getModule(modId);
    if (modchart == null)
      return;

    modchart.load(diff);
  }

  public override function onSongRetry(event) {
    super.onSongRetry(event);
    rimOn();
    var hexOg = PlayState.instance.currentStage.getDad(true);
		var bfOg = PlayState.instance.currentStage.getBoyfriend(true);
    var gf = PlayState.instance.currentStage.getGirlfriend(true);

    PlayState.instance.currentStage.addCharacter(gf, CharacterType.GF);
    PlayState.instance.currentStage.addCharacter(hexOg, CharacterType.DAD);
    PlayState.instance.currentStage.addCharacter(bfOg, CharacterType.BF);

    loadModchart();
  }

  public function listDifficulties(variationId:String, variationIds:Array<String>, showLocked:Bool):Array<String>
	{
		return [];
	}

  // BF and GF are the old sheets in the LCD red look (the detected sheets were the same art).
  function rimOn() {
    var rim = ModuleHandler.getModule("CharacterRim");
    if (rim != null)
      rim.enable("weekend-lcdred");
  }
}
