	public function new() {
  	    super("rightpace");
	}

	public function listDifficulties(variationId:String, variationIds:Array<String>, showLocked:Bool):Array<String> {
		return [];
	}

	public function pushPaletteColors(newColors:Array<Array<Float>>) {
		for (i in 0...newColors.length)
			bgShader.setFloatArray("tColor" + (i + 1), newColors[i]);
	}

	public function pushSourcePaletteColors(newColors:Array<Array<Float>>) {
		trace(bgShader);
		for (i in 0...newColors.length)
			bgShader.setFloatArray("color" + (i + 1), newColors[i]);
	}

	public function pushBfPaletteColors(newColors:Array<Array<Float>>) {
		for (i in 0...newColors.length)
			bfShader.setFloatArray("tColor" + (i + 1), newColors[i]);
	}
	
	public function pushBfSourcePaletteColors(newColors:Array<Array<Float>>) {
		for (i in 0...newColors.length)
			bfShader.setFloatArray("color" + (i + 1), newColors[i]);
	}

	var toGoBeat:Float = 0;
	var beatLength:Float = 0;

	var startColorLerp:Array<Array<Float>> = [];
	var startColorBFLerp:Array<Array<Float>> = [];

	var startSwirlyColor1Lerp:Array<Float> = [];
	var startSwirlyColor2Lerp:Array<Float> = [];

	// The module outlives PlayState, so a sprite it held onto from a previous run has already
	// been destroyed and its controllers are gone. Rebuild rather than reuse.
	function dead(sprite:FlxSprite):Bool {
		return sprite == null || sprite.animation == null;
	}

	// The notefield and HEX-HUD both swap parts of the HUD out, so any one of these is missing
	// on some runs and the fade must not take the whole update with it.
	function fade(sprite:Dynamic, by:Float) {
		if (sprite == null)
			return;
		sprite.alpha -= by;
		if (sprite.alpha < 0.0)
			sprite.alpha = 0.0;
	}

	function setAlpha(sprite:Dynamic, to:Float) {
		if (sprite != null)
			sprite.alpha = to;
	}

	function deepCopyArray(arr:Array<Array<Float>>):Array<Array<Float>> {
		var newArr:Array<Array<Float>> = [];
		for (subArr in arr) {
			var newSubArr:Array<Float> = [];
			for (value in 0...subArr.length) {
				newSubArr.push(subArr[value]);
			}
			newArr.push(newSubArr);
		}
		return newArr;
	}

	function getCurrentBeat():Float
	{
		if (FlxG.sound.music == null || Conductor.instance == null)
			return 0;
		return Conductor.instance.currentBeatTime;
	}

	var transitionActive:Bool = false;

	public function pushPalette(number:Int)
	{
		beatLength = 1;
		toGoBeat = getCurrentBeat() + beatLength;
		transitionActive = true;
		switch(number)
		{
			case 1:
				swirlyColor1Target = swirlyPalette1Color1.copy();
				swirlyColor2Target = swirlyPalette1Color2.copy();
				targetColors = deepCopyArray(palette1);
				targetColorsBF = deepCopyArray(paletteBF1);
			case 2:
				trace("Palette 1: " + palette1);
				swirlyColor1Target = swirlyPalette2Color1.copy();
				swirlyColor2Target = swirlyPalette2Color2.copy();
				targetColors = deepCopyArray(palette2);
				targetColorsBF = deepCopyArray(paletteBF2);
			case 3:
				swirlyColor1Target = swirlyPalette3Color1.copy();
				swirlyColor2Target = swirlyPalette3Color2.copy();
				targetColors = deepCopyArray(palette3);
				targetColorsBF = deepCopyArray(paletteBF3);
			case 4:
				swirlyColor1Target = swirlyPalette4Color1.copy();
				swirlyColor2Target = swirlyPalette4Color2.copy();
				targetColors = deepCopyArray(palette4);
				targetColorsBF = deepCopyArray(paletteBF4);
			case 5:
				swirlyColor1Target = swirlyPalette5Color1.copy();
				swirlyColor2Target = swirlyPalette5Color2.copy();
				targetColors = deepCopyArray(palette5);
				targetColorsBF = deepCopyArray(paletteBF5);
			case 6:
				swirlyColor1Target = swirlyPalette6Color1.copy();
				swirlyColor2Target = swirlyPalette6Color2.copy();
				targetColors = deepCopyArray(palette6);
				targetColorsBF = deepCopyArray(paletteBF6);
			case 7:
				swirlyColor1Target = swirlyPalette7Color1.copy();
				swirlyColor2Target = swirlyPalette7Color2.copy();
				targetColors = deepCopyArray(palette7);
				targetColorsBF = deepCopyArray(paletteBF7);
			case 8:
				swirlyColor1Target = swirlyPalette8Color1.copy();
				swirlyColor2Target = swirlyPalette8Color2.copy();
				targetColors = deepCopyArray(palette8);
				targetColorsBF = deepCopyArray(paletteBF8);
		}

		startColorLerp = deepCopyArray(targetColorsLerp);
		startColorBFLerp = deepCopyArray(targetColorsBFLerp);
		startSwirlyColor1Lerp = swirlyColor1Lerp.copy();
		startSwirlyColor2Lerp = swirlyColor2Lerp.copy();

		trace("Pushed Palette " + number);
		trace("Beat length: " + beatLength + " toGoBeat: " + toGoBeat);
	}

	public function forcePalette(number:Int)
	{
		pushPalette(number);
		currentPalette = number;
		transitionActive = false;
		targetColorsLerp = deepCopyArray(targetColors);
		targetColorsBFLerp = deepCopyArray(targetColorsBF);
		swirlyColor1Lerp = swirlyColor1Target.copy();
		swirlyColor2Lerp = swirlyColor2Target.copy();

		startColorLerp = deepCopyArray(targetColorsLerp);
		startColorBFLerp = deepCopyArray(targetColorsBFLerp);
		startSwirlyColor1Lerp = swirlyColor1Lerp.copy();
		startSwirlyColor2Lerp = swirlyColor2Lerp.copy();

		
		swirlyShader.setFloatArray("uColor1", swirlyColor1Lerp);
		swirlyShader.setFloatArray("uColor2", swirlyColor2Lerp);

		pushPaletteColors(targetColorsLerp);
		pushBfPaletteColors(targetColorsBFLerp);

		trace("Forced Palette " + number);
	}

	public override function onSongRetry(event) {
		super.onSongRetry(event);

		loadModchart();

		p2IconHidden = false;
		hexCentered = false;
		hideP2Icon();

		hex().offset.y = 40;

		var bf = hex();
		if (bf != null)
		{
			bf.y = -270;
			hexCentered = false;
			centerHex();
		}

		if (blackBox != null)
			blackBox.alpha = 0.0;

		var keQOL = ModuleHandler.getModule("KE-QOL");

		setAlpha(keQOL.scoreText, 1.0);

		PlayState.instance.comboPopUps.visible = true;
		setAlpha(PlayState.instance.iconP1, 1.0);
		setAlpha(PlayState.instance.iconP2, 1.0);

		setAlpha(keQOL.healthBar, 1.0);
		setAlpha(keQOL.healthBarBG, 1.0);

		setAlpha(hud.leftCircle, 1.0);
		setAlpha(hud.rightCircle, 1.0);
		setAlpha(hud.timer, 1.0);

		blackBox.alpha = 0.0;
 
		forcePalette(1);
	}

