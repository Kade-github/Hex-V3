			343 => 9
		];

	function createPls()
	{
		if (bgShader == null)
		{
			bgShader = new FlxRuntimeShader(Assets.getText(Paths.frag("ui/shaders/palette_converter")));
			bfShader = new FlxRuntimeShader(Assets.getText(Paths.frag("ui/shaders/palette_converter")));
			swirlyShader = new FlxRuntimeShader(Assets.getText(Paths.frag("ui/shaders/swirl")));
		}

		hud = ModuleHandler.getModule("HEX-HUD");

		targetColors = deepCopyArray(palette1);
		targetColorsBF = deepCopyArray(paletteBF1);

        swirlyShader.setFloat("uTime", 0);
        swirlyShader.setFloat("uMix", 1);
        swirlyShader.setFloatArray("uColor1", [1.0, 1.0, 1.0]);
        swirlyShader.setFloatArray("uColor2", [0.251, 0.965, 0.937]);
        swirlyShader.setFloat("uIntensity", 25.0);

		pushSourcePaletteColors(palette2);
		pushBfSourcePaletteColors(paletteBF2);

		forcePalette(1);
	}

	public override function onCreate(event) {
		super.onCreate(event);

		createPls();
	}

	function loadModchart() {
		var modchart = ModuleHandler.getModule("rightpace_modchart");
		if (modchart == null) {
			trace("rightpace: no rightpace_modchart module, the notefield will not come up");
			return;
		}

		modchart.load(PlayState.instance.currentDifficulty);

		// scriptCall lands on the script's own functions, and load lives on the compiled Chart
		// it extends, so the flag is set here rather than trusted to the call.
		modchart.armed = true;
	}

	// PlayState builds the icons after the song loads on some paths, so this keeps trying
	// from onUpdate until there is something to hide.
	var p2IconHidden:Bool = false;

	function hideP2Icon() {
		if (p2IconHidden || PlayState.instance == null || PlayState.instance.iconP2 == null)
			return;
		PlayState.instance.iconP2.visible = false;
		p2IconHidden = true;
	}

	public override function onSongLoaded(event) {
		createPls();

		loadModchart();

		p2IconHidden = false;
		hexCentered = false;
		hideP2Icon();

		var swirlBG = PlayState.instance.currentStage.getNamedProp("swirl");
		swirlBG.shader = swirlyShader;
		
		var bg = PlayState.instance.currentStage.getNamedProp("bg");
		bg.shader = bgShader;

		swirlBG.x = bg.x;
		swirlBG.y = bg.y - 20;
		viewBG = bg;
		lockCamera();

		// hide dad/gf
		var dad = PlayState.instance.currentStage.getDad();
		var gf = PlayState.instance.currentStage.getGirlfriend();

		PlayState.instance.camHUD.followLerp = 0;
		PlayState.instance.camGame.followLerp = 0;

		var bf = hex();
		if (bf == null || bf.scale == null)
		{
			trace("rightpace: no live boyfriend on song load");
			return;
		}
		bf.shader = bfShader;
		// The stage mark shrinks him to 0.9, and this song wants him at his own size.
		bf.setScale(bf.getBaseScale());
		bf.y = -270;
		hexCentered = false;
		centerHex();

		dad.visible = false;
		gf.visible = false;

		coolBG = PlayState.instance.currentStage.getNamedProp("coolerBG");
		coolBG.visible = false;
		coolBG.alpha = 0.0;

		richard = PlayState.instance.currentStage.getNamedProp("richard");
		richard.visible = false;
		richard.alpha = 0.0;
		
		bf.animation.play("idle");

		if (dead(blackBox))
		{
			blackBox = new FlxSprite(coolBG.x, coolBG.y);
			blackBox.makeGraphic(coolBG.width, coolBG.height, FlxColor.BLACK);

			blackBox.zIndex = 1000;
			PlayState.instance.currentStage.add(blackBox);
			blackBox.alpha = 0.0;
		}

		PlayState.instance.currentStage.refresh();
	}

	var currentPalette:Int = 1;

	var viewBG:FlxSprite = null;

	function lockCamera()
	{
		if (viewBG == null || PlayState.instance == null)
			return;

		var cam = PlayState.instance.camGame;
		cam.scroll.set(viewBG.x + viewBG.width / 2 - FlxG.width / 2, viewBG.y + viewBG.height / 2 - FlxG.height / 2);
		PlayState.instance.cameraFollowPoint.setPosition(viewBG.x + viewBG.width / 2, viewBG.y + viewBG.height / 2);
	}

	var redBarFor:Dynamic = null;

	var iconBop:Float = 0;
	var iconBopTime:Float = 0.175;

	public override function onStepHit(event)
	{
		super.onStepHit(event);

		if (event.step % 4 == 0)
		{
			iconBop = 1;
			iconBopTime = Math.min(Conductor.instance.stepLengthMs * 0.002, 0.175);
		}
	}

	function centerIconOnBar(elapsed:Float)
	{
		var icon = PlayState.instance.iconP1;
		var keQOL = ModuleHandler.getModule("KE-QOL");
		if (icon == null || keQOL == null || keQOL.healthBar == null) return;
		var bar = keQOL.healthBar;
		if (redBarFor != bar)
		{
			redBarFor = bar;
			bar.createColoredEmptyBar(FlxColor.fromRGB(239, 58, 45));
		}

		icon.autoUpdate = false;
		icon.bopEvery = 0;
		@:privateAccess
		icon.updateHealthIcon(PlayState.instance.health);

		if (iconBop > 0)
		{
			iconBop -= elapsed / iconBopTime;
			if (iconBop < 0)
				iconBop = 0;
		}
		icon.setGraphicSize(Std.int(150 * icon.size.x * (1 + 0.2 * iconBop)), 0);
		icon.updateHitbox();
		var divider:Float = bar.x + bar.width * (1 - bar.percent / 100);
		icon.x = divider - icon.width / 2;
		icon.y = PlayState.instance.healthBar.y - icon.height / 2;
	}

	public override function onUpdate(event) {
		timeElapsed += event.elapsed;

		hideP2Icon();
		centerIconOnBar(event.elapsed);
		lockCamera();

		swirlyShader.setFloat("uTime", timeElapsed * 0.2);

		var songTime = (FlxG.sound.music != null && Conductor.instance != null) ? Conductor.instance.songPosition : 0;

		var currentBeat:Float = getCurrentBeat();

		if (Std.int(currentBeat) >= 308 && Std.int(currentBeat) < 312) // Fill black screen
		{
			blackBox.alpha += event.elapsed;
			if (blackBox.alpha > 1.0)
				blackBox.alpha = 1.0;
		}

		if (Std.int(currentBeat) >= 312 && blackBox.alpha > 0 && Std.int(currentBeat) < 342)
		{
			hex().y = -180;
			centerHex();
			hud.hideBars();
			hud.hideHealth();
			blackBox.alpha -= event.elapsed * 8.45;
			if (blackBox.alpha < 0.0)
				blackBox.alpha = 0.0;
			
		}

		if (Std.int(currentBeat) >= 342 && Std.int(currentBeat) < 344) // Fill black screen again
		{
			var keQOL = ModuleHandler.getModule("KE-QOL");

			var by = event.elapsed * 3.45;

			fade(keQOL.scoreText, by);

			@:privateAccess
        	PlayState.instance.comboPopUps.visible = false;

			fade(PlayState.instance.iconP1, by);
			fade(PlayState.instance.iconP2, by);

			fade(keQOL.healthBarBG, by);
			fade(keQOL.healthBar, by);

			fade(hud.leftCircle, by);
			fade(hud.rightCircle, by);

			fade(hud.timer, by);

			blackBox.alpha += event.elapsed * 3.45;
			if (blackBox.alpha > 1.0)
				blackBox.alpha = 1.0;
		}

		if (Std.int(currentBeat) >= 344)
		{
			blackBox.alpha -= event.elapsed * 8.45;
			if (blackBox.alpha < 0.0)
				blackBox.alpha = 0.0;
		}

		if (paletteSwaps.exists(Std.int(currentBeat)))
		{
			var newPalette = paletteSwaps.get(Std.int(currentBeat));
			if (newPalette != currentPalette)
			{
				currentPalette = newPalette;
				pushPalette(currentPalette);
			}
		}
		if (transitionActive)
		{
			var t:Float = (currentBeat - (toGoBeat - beatLength)) / beatLength;
			if (t < 0)
				t = 0;
			if (t >= 1)
			{
				t = 1;
				transitionActive = false;
			}

			var rt = FlxEase.cubeInOut(t);

			for (i in 0...targetColorsLerp.length) {
				for (j in 0...3) {
					targetColorsLerp[i][j] = FlxMath.lerp(startColorLerp[i][j], targetColors[i][j], rt);
					targetColorsBFLerp[i][j] = FlxMath.lerp(startColorBFLerp[i][j], targetColorsBF[i][j], rt);

					swirlyColor1Lerp[j] = FlxMath.lerp(startSwirlyColor1Lerp[j], swirlyColor1Target[j], rt);
					swirlyColor2Lerp[j] = FlxMath.lerp(startSwirlyColor2Lerp[j], swirlyColor2Target[j], rt);

					if (currentPalette == 9)
					{
						coolBG.visible = true;
						richard.visible = true;
						if (coolBG.alpha < 1.0)
						{
							coolBG.alpha = FlxMath.lerp(0.0, 1, rt);
							richard.alpha = FlxMath.lerp(0.0, 1, rt);
						}
					}
				}
			}
		

			swirlyShader.setFloatArray("uColor1", swirlyColor1Lerp);
			swirlyShader.setFloatArray("uColor2", swirlyColor2Lerp);

			pushPaletteColors(targetColorsLerp);
			pushBfPaletteColors(targetColorsBFLerp);
		}
	}
}
