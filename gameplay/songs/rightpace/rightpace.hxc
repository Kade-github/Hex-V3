	// Read live rather than held, since SwitchCharacters puts a different instance in the
	// bf slot partway through the song.
	function hex():BaseCharacter {
		if (PlayState.instance == null || PlayState.instance.currentStage == null)
			return null;
		return PlayState.instance.currentStage.getBoyfriend();
	}

	// Once only. Width follows the animation frame, so centering every tick would walk him
	// sideways a pixel at a time.
	var hexCentered:Bool = false;

	// Same sum SwitchCharacters uses, so the swap does not shift him sideways.
	function centerHex() {
		var bf = hex();
		if (hexCentered || bf == null)
			return;
		hexCentered = true;
		bf.x = PlayState.instance.camGame.scroll.x + (FlxG.width - bf.width) * 0.5;
		bf.originalPosition.set(bf.x, bf.y);
		bf.resetCameraFocusPoint();
	}

